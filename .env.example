# Local PostgreSQL database. Heroku provides DATABASE_URL automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/architectures

# Use a long, random value and keep it stable between deployments.
JWT_SECRET=replace-with-a-long-random-secret

# Public origin used to build verification and password-reset links.
APP_BASE_URL=http://localhost:5173

# Provisioning the Mailgun add-on sets MAILGUN_API_KEY and MAILGUN_DOMAIN.
MAILGUN_API_KEY=replace-with-mailgun-api-key
MAILGUN_DOMAIN=replace-with-verified-mailgun-domain

# Optional: set to eu when the Mailgun domain is hosted in the EU region.
MAILGUN_REGION=eu

# Optional: defaults to Architecture Editor <postmaster@MAILGUN_DOMAIN>.
EMAIL_FROM="Architecture Editor <postmaster@example.com>"
